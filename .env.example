# EchoFlow never loads this file implicitly. Copy it to a private location and
# select it with: echoflow --config /path/to/echoflow.env COMMAND

ECHOFLOW_LOG_LEVEL=INFO
ECHOFLOW_LOG_PATHS=redact
ECHOFLOW_PROCESSING_PROFILE=balanced
ECHOFLOW_MEMORY_BUDGET_FRACTION=0.75
ECHOFLOW_FFPROBE_TIMEOUT_SECONDS=30
ECHOFLOW_FFMPEG_PROCESS_TIMEOUT_SECONDS=3600

# Optional model revision. Set a commit SHA for immutable model retrieval.
# ECHOFLOW_FASTER_WHISPER_MODEL_REVISION=commit-sha

# Optional user ceilings. Leave unset to use process-visible runner limits.
# ECHOFLOW_MAX_CPU_THREADS=4
# ECHOFLOW_MAX_MEMORY_BYTES=8589934592

# Optional platform-default overrides.
# ECHOFLOW_STATE_DIR=/private/path/echoflow-state
# ECHOFLOW_CACHE_DIR=/private/path/echoflow-cache
# ECHOFLOW_MODEL_DIR=/private/path/echoflow-cache/models
# ECHOFLOW_OUTPUT_DIR=/path/to/Downloads/EchoFlow
