# Scholion never loads this file implicitly. Copy it to a private location and
# select it with: scholion --config /path/to/scholion.env COMMAND

SCHOLION_LOG_LEVEL=INFO
SCHOLION_LOG_PATHS=redact
SCHOLION_PROCESSING_PROFILE=balanced
SCHOLION_MEMORY_BUDGET_FRACTION=0.75
SCHOLION_FFPROBE_TIMEOUT_SECONDS=30
SCHOLION_FFMPEG_PROCESS_TIMEOUT_SECONDS=3600

# Optional user ceilings. Leave unset to use process-visible runner limits.
# SCHOLION_MAX_CPU_THREADS=4
# SCHOLION_MAX_MEMORY_BYTES=8589934592

# Optional platform-default overrides.
# SCHOLION_STATE_DIR=/private/path/scholion-state
# SCHOLION_CACHE_DIR=/private/path/scholion-cache
# SCHOLION_MODEL_DIR=/private/path/scholion-cache/models
# SCHOLION_OUTPUT_DIR=/path/to/Downloads/Scholion
