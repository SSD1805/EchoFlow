{
  "name": "echoflow-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --strictPort",
    "dev:mock": "vite --strictPort --open '/?e2e=1'",
    "doctor:desktop": "node scripts/desktop-doctor.mjs",
    "check:tauri-versions": "node scripts/check-tauri-versions.mjs",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.4.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.15.32",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.67.0",
    "vite": "8.2.1"
  }
